      FOR EACH record IN Raw_Data_Stream:
        APPLY_BUSINESS_RULES(record)
        PERFORM_DATA_VALIDATION(record)
        APPLY_DATA_TYPE_CONVERSIONS(record)
        HANDLE_NULL_VALUE_PROCESSING(record)
        APPLY_FIELD_MAPPINGS_AND_CALCULATIONS(record)
        
        IF VALIDATION_PASSED(record) THEN
          OUTPUT record TO Transformed_Data_Stream
        ELSE
          OUTPUT record TO Exception_Data_Stream
        END IF
      END FOR
    
    OUTPUT_LINKS:
      Transformed_Data_Stream (LINK_TYPE: 1, TARGET: Main_Data_Output)
      Exception_Data_Stream (LINK_TYPE: 1, TARGET: Exception_Data_Processing)
    NEXT_LINK: Transformed_Data_Stream -> Main_Data_Output
    EXCEPTION_NEXT_LINK: Exception_Data_Stream -> Exception_Data_Processing
  
  STAGE_EXCEPTION_DATA_PROCESSING:
    TYPE: Transformer
    OPERATION: FORMAT_EXCEPTION_RECORDS_FOR_OUTPUT
    INPUT_LINK: Exception_Data_Stream (FROM DATA_TRANSFORMATION)
    PREVIOUS_LINK: Data_Transformation -> Exception_Data_Stream
    
    EXCEPTION_PROCESSING_OPERATIONS:
      FOR EACH exception_record IN Exception_Data_Stream:
        FORMAT_EXCEPTION_RECORDS_FOR_OUTPUT(exception_record)
        ADD_ERROR_CODES_AND_DESCRIPTIONS(exception_record)
        APPLY_EXCEPTION_HANDLING_BUSINESS_LOGIC(exception_record)
        PREPARE_DATA_FOR_FILE_OUTPUT_FORMAT(exception_record)
        
        processed_exception = CREATE_PROCESSED_EXCEPTION_RECORD(exception_record)
        OUTPUT processed_exception TO Processed_Exception_Stream
      END FOR
    
    OUTPUT_LINK: Processed_Exception_Stream
    LINK_TYPE: 1
    TARGET_STAGE: Load_VOR_Exception_File
    NEXT_LINK: Processed_Exception_Stream -> Load_VOR_Exception_File
  
