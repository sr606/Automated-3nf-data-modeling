      FOR EACH record IN Lnk_Vehicle_off_Road_Data:
        CLEAN_REGISTRATION_NO = TRIM_WHITESPACE(record.VOR_REGISTRATION_NUMBER)
        REG_VALIDATION_FLAG = VALIDATE_NOT_NULL(record.VOR_REGISTRATION_NUMBER)
        STANDARDIZED_REG_NO = UPPER_CASE(record.VOR_REGISTRATION_NUMBER)
        PROCESSED_OBJECT_NO = COALESCE(record.VOR_OBJECT_NO, 'UNKNOWN')
        CUST_ID_VALID = VALIDATE_NUMERIC(record.VOR_CUST_ID)
        VARIANT_SK_VALID = VALIDATE_NUMERIC(record.VOR_VARIANT_SK)
        
        CONSTRAINT_LOGIC:
          IF REG_VALIDATION_FLAG = FALSE THEN
            REJECT_RECORD(record)
          ELSE
            transformed_record = CREATE_TRANSFORMED_RECORD(CLEAN_REGISTRATION_NO, STANDARDIZED_REG_NO, PROCESSED_OBJECT_NO, CUST_ID_VALID, VARIANT_SK_VALID)
