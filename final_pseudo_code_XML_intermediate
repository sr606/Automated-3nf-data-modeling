        UPDATE_REJECT_RECORD_COUNT()
      END FOR
      
      CLOSE_SEQUENTIAL_FILE(reject_file_path)
      VALIDATE_REJECT_FILE_CREATION(reject_file_path)
  
  STAGE_TARGET_LOAD:
    TYPE: OracleConnector
    OPERATION: LOAD_INTEGRATED_VOR_DATA_TO_TARGET_TABLE
    INPUT_LINK: Transformed_VOR_Data (FROM DATA_INTEGRATION_TRANSFORM)
    CONNECTION: psOraDB
    TARGET_TABLE: TARGET_SCHEMA.VOR_FACT_TABLE
    LOAD_TYPE: INSERT/UPDATE
    PREVIOUS_LINK: Data_Integration_Transform -> Transformed_VOR_Data
    
    TARGET_LOAD_OPERATIONS:
      ESTABLISH_CONNECTION(psOraDB)
      VALIDATE_TARGET_TABLE_EXISTENCE("TARGET_SCHEMA.VOR_FACT_TABLE")
      PREPARE_LOAD_STATEMENTS()
      
      FOR EACH integrated_record IN Transformed_VOR_Data:
        IF LOAD_TYPE = "INSERT/UPDATE" THEN
          existing_record = CHECK_RECORD_EXISTS(integrated_record.primary_key)
          
          IF existing_record.FOUND THEN
            UPDATE_RECORD(integrated_record, "TARGET_SCHEMA.VOR_FACT_TABLE")
          ELSE
            INSERT_RECORD(integrated_record, "TARGET_SCHEMA.VOR_FACT_TABLE")
          END IF
        ELSE
          INSERT_RECORD(integrated_record, "TARGET_SCHEMA.VOR_FACT_TABLE")
        END IF
        
        UPDATE_LOAD_STATISTICS()
      END FOR
      
      COMMIT_TRANSACTION()
      CLOSE_CONNECTION()
      VALIDATE_LOAD_COMPLETION()
    
    ERROR_HANDLING:
      HANDLE_INSERT_UPDATE_CONFLICTS()
      LOG_FAILED_RECORDS()
      MAINTAIN_DATA_INTEGRITY_CONSTRAINTS()
    
    OUTPUT_LINK: Load_Completion_Status
    LINK_TYPE: 1
    TARGET_STAGE: JOB_COMPLETION_HANDLER
    NEXT_LINK: Load_Completion_Status -> JOB_COMPLETION_HANDLER
  
  GOTO LINK_24_ORACLE_CONNECTOR_ENHANCED_PROCESSING

LINK_24_ORACLE_CONNECTOR_ENHANCED_PROCESSING:
  STAGE_ORACLE_CONNECTOR_ENHANCED:
    TYPE: OracleConnector
    OPERATION: ENHANCED_RECORD_LEVEL_PROCESSING
    INPUT_LINK: Load_StgVehicleoffRoad (FROM V0S13)
    
    PROPERTIES:
      VariantName = "10"
      VariantLibrary = "ccora10g"
      VariantVersion = "1.0"
      ConnectorName = "OracleConnector"
      RejectFromLink = -1
      RejectThreshold = 0
      RejectNumber = 0
      RejectUsesPercentage = false
      XMLProperties = ""
      RejectConditions = ""
      RejectDataElements = ""
      XMLRejectSettings = ""
    
    LOAD_CONFIG:
      Name = "Load_StgVehicleoffRoad"
      Partner = "V0S13|V0S13P1"
      LinkType = 1
      ConditionNotMet = "fail"
      LookupFail = "fail"
      TransactionSize = 0
      TXNBehaviour = 0
      EnableTxGroup = 0
      LinkMinimised = 0
    
    CONNECTION_HANDLING:
      INITIALIZE_ORACLE_CONNECTION()
      ESTABLISH_PARTNER_CONNECTION(Partner)
      VALIDATE_CONNECTION_STATUS()
    
    DATA_PROCESSING:
      FETCH_SOURCE_DATA()
      
      FOR_EACH_RECORD:
        APPLY_RECORD_LEVEL_VALIDATION()
        
        IF CONDITION_CHECK_FAILS THEN
          IF ConditionNotMet == "fail" THEN
            TERMINATE_PROCESSING()
            SEND_TO_ERROR_HANDLER()
          END IF
        END IF
        
        IF LOOKUP_OPERATION_REQUIRED THEN
          PERFORM_LOOKUP()
          IF LOOKUP_FAILS THEN
            IF LookupFail == "fail" THEN
              TERMINATE_PROCESSING()
              SEND_TO_ERROR_HANDLER()
            END IF
          END IF
        END IF
        
        TRANSFORM_RECORD()
        STAGE_RECORD_FOR_LOAD()
      END FOR
    
    TRANSACTION_MANAGEMENT:
      IF TransactionSize > 0 THEN
        PROCESS_IN_BATCHES(TransactionSize)
      ELSE
        PROCESS_ALL_RECORDS_IN_SINGLE_TRANSACTION()
      END IF
      
      APPLY_TRANSACTION_BEHAVIOUR(TXNBehaviour)
      
      IF EnableTxGroup == 1 THEN
        ENABLE_TRANSACTION_GROUPING()
      END IF
    
    ERROR_HANDLING:
      IF RejectThreshold > 0 THEN
        CAPTURE_REJECTS_TO_LINK(RejectFromLink)
      END IF
      
      IF RejectUsesPercentage == true THEN
        CALCULATE_REJECT_PERCENTAGE(RejectNumber)
      ELSE
        COUNT_REJECT_RECORDS(RejectNumber)
      END IF
      
      HANDLE_CONDITION_FAILURES()
      HANDLE_LOOKUP_FAILURES()
    
    DATA_LOADING:
      LOAD_TO_TARGET_TABLE("StgVehicleoffRoad")
      COMMIT_TRANSACTIONS()
      UPDATE_LOAD_STATISTICS()
    
    OUTPUT_LINKS:
      Main_Output -> NEXT_STAGE
      Reject_Output -> REJECT_HANDLER (IF RejectFromLink != -1)
      Error_Output -> ERROR_HANDLER (IF ConditionNotMet == "fail" OR LookupFail == "fail")
      Success_Output -> COMPLETION_HANDLER
  
  GOTO LINK_25_OUTPUT_GENERATION_AND_REPORTING

