          REGISTRATION_NUMBER = normal_record.REGISTRATION_NUMBER
          GARAGE_NAME = normal_record.GARAGE_NAME
          DESCRIPTION = normal_record.DESCRIPTION
        
        formatted_normal = FORMAT_NORMAL_OUTPUT(normal_record)
        WRITE_RECORD(formatted_normal, target_output_path)
        UPDATE_NORMAL_OUTPUT_COUNT()
      END FOR
      
      CLOSE_SEQUENTIAL_FILE(target_output_path)
      VALIDATE_NORMAL_OUTPUT_FILE_CREATION(target_output_path)
  
  STAGE_SEQUENTIAL_FILE_TARGET_ORIGINAL:
    TYPE: CSeqFileStage
    OPERATION: WRITE_PROCESSED_VEHICLE_RECORDS
    INPUT_LINK: vehicle_processed_data (FROM TRANSFORMER_V0A16)
    
    TARGET_FILE_OPERATIONS:
