      BlockSize = 0
      StageVarsMinimised = 0
      LoopVarsMaximised = 0
      MaxLoopIterations = 0
      ValidationStatus = 0
    
    STAGE_VARIABLES:
      svException = If Lnk_Vehicle_off_Road_Data.SUPP_SK=-99 then -1 Else IF Lnk_Vehicle_off_Road_Data.SUPP_SK=-97 then -1 else 0
    
    TRANSFORMATION_LOGIC:
      FOR EACH record IN Lnk_Vehicle_off_Road_Data:
        lookup_result = LOOKUP(lkVehicleDim_REg, record.vehicle_id)
        
        CALCULATE_EXCEPTION_FLAG:
          IF record.SUPP_SK = -99 THEN
            SET svException = -1
          ELSE IF record.SUPP_SK = -97 THEN
            SET svException = -1
          ELSE
            SET svException = 0
          END IF
        
        IF lookup_result.FOUND THEN
          transformed_record = APPLY_TRANSFORMATION_RULES(record, lookup_result.data, TRANSFORMATION_RULES)
          enhanced_record = APPLY_VEHICLE_OFF_ROAD_RULES(transformed_record, VEHICLE_OFF_ROAD_RULES)
          enhanced_record.svException = svException
          
          IF svException = 0 THEN
            OUTPUT enhanced_record TO Load_HFVehicleoffRoad (V0S2P2)
          ELSE
            error_record = CREATE_ERROR_RECORD(enhanced_record, "SUPP_SK validation failed")
            OUTPUT error_record TO Load_VOR_Exception_File (V0S2P3)
          END IF
        ELSE
          error_record = CREATE_LOOKUP_ERROR_RECORD(record, "Vehicle dimension not found")
          error_record.svException = -1
          OUTPUT error_record TO Load_VOR_Exception_File (V0S2P3)
        END IF
      END FOR
    
    OUTPUT_LINKS:
      Load_HFVehicleoffRoad (V0S2P2, LINK_TYPE: 1, TARGET: V0S13)
      Load_VOR_Exception_File (V0S2P3, LINK_TYPE: 1, TARGET: V96S0)
  
