        CHECK_MANDATORY_FIELDS(transformed_record)
        APPLY_BUSINESS_RULES_VALIDATION(transformed_record)
        
        OUTPUT transformed_record TO Transformed_VOR_Data
      END FOR
    
    OUTPUT_LINK: Transformed_VOR_Data
    LINK_TYPE: 1
    TARGET_STAGE: STG_VEHICLE_OFF_ROAD_FACT
  
  STAGE_VEHICLE_OFFROAD_TRANSFORMER:
    TYPE: CTransformerStage
    OPERATION: TRANSFORM_VEHICLE_OFFROAD_FACT_DATA
    INPUT_LINK: source_data_link (FROM Source_Connector)
    
    COLUMN_DEFINITIONS:
      WORKSHEET_NUMBER: VARCHAR(20), NULLABLE, PRIMARY_KEY_POSITION=1
      ORIGINAL_WORKSHEET_NUMBER: VARCHAR(20), NULLABLE
      VOR_PROGRESS_SK: DECIMAL(19,0), NULLABLE, MAPS_TO=VOR_NON_RETURN_REASON_SK
      REGISTERED_CUST_DRIVER_SK: DECIMAL(19,0), NULLABLE
      VEHICLE_SK: DECIMAL(19,0), NULLABLE
      VARIANT_SK: DECIMAL(19,0), NULLABLE
      SUPP_SK: DECIMAL(19,0), NULLABLE
      CUSTOMER_SK: DECIMAL(19,0), NULLABLE
      RENTAL_BOOKING_SK: DECIMAL(10,0), NULLABLE
      VOR_NOTE_SK: DECIMAL(19,0), NULLABLE
      ORIGINAL_APPOINTMENT_DATE_SK: DECIMAL(19,0), NULLABLE
      JOB_CLOSED_DATE_SK: DECIMAL(19,0), NULLABLE
      VOR_PASSED_DATE_SK: DECIMAL(19,0), NULLABLE
      DRIVER_COLLECTION_DATE_SK: DECIMAL(38,0), NULLABLE
      RENTAL_BOOKING_REFERENCE: DECIMAL(10,0), NULLABLE, MAPS_TO=BOOKING_REFERENCE
      VOR_REGISTRATION_NUMBER: VARCHAR(10), NULLABLE
      CAPTURED_GARAGE_NAME: VARCHAR(255), NULLABLE
      CONTACT_DRIVER_NAME: VARCHAR(255), NULLABLE
      VOR_INCIDENT_SOURCE: VARCHAR(20), NULLABLE
      VOR_WORK: VARCHAR(2000), NULLABLE
      CRS_LOG_ID: VARCHAR(20), NULLABLE
      MILEAGE: DECIMAL(38,0), NULLABLE
      NUMBER_OF_WORKING_DAYS_VOR: DECIMAL(38,0), NULLABLE
      NUMBER_OF_DAYS_VOR: DECIMAL(38,0), NULLABLE
      COMPLETION_TO_COLLECT_DAYS: DECIMAL(38,0), NULLABLE
    
    TRANSFORMATION_LOGIC:
      INITIALIZE_TRANSFORMATION_CONTEXT()
      SET_ERROR_HANDLING_MODE()
      
      FOR EACH input_row FROM source_data_link:
        BEGIN_RECORD_PROCESSING()
        
        VALIDATE_RECORD_COMPLETENESS(input_row)
        CHECK_MANDATORY_FIELDS(input_row)
        
        TRY:
          VALIDATE_AND_CONVERT(WORKSHEET_NUMBER, VARCHAR, 20)
          VALIDATE_AND_CONVERT(ORIGINAL_WORKSHEET_NUMBER, VARCHAR, 20)
        CATCH validation_error:
          LOG_VALIDATION_ERROR(validation_error)
          SEND_TO_REJECT_LINK(input_row, reject_data_link)
          CONTINUE
        
        PROCESS_SURROGATE_KEY_LOOKUP(VOR_PROGRESS_SK, VOR_NON_RETURN_REASON_SK)
        PROCESS_SURROGATE_KEY_LOOKUP(REGISTERED_CUST_DRIVER_SK)
        PROCESS_SURROGATE_KEY_LOOKUP(VEHICLE_SK)
        PROCESS_SURROGATE_KEY_LOOKUP(VARIANT_SK)
        PROCESS_SURROGATE_KEY_LOOKUP(SUPP_SK)
        PROCESS_SURROGATE_KEY_LOOKUP(CUSTOMER_SK)
        PROCESS_SURROGATE_KEY_LOOKUP(RENTAL_BOOKING_SK)
        PROCESS_SURROGATE_KEY_LOOKUP(VOR_NOTE_SK)
        
        PROCESS_DATE_KEY_TRANSFORMATION(ORIGINAL_APPOINTMENT_DATE_SK)
        PROCESS_DATE_KEY_TRANSFORMATION(JOB_CLOSED_DATE_SK)
        PROCESS_DATE_KEY_TRANSFORMATION(VOR_PASSED_DATE_SK)
        PROCESS_DATE_KEY_TRANSFORMATION(DRIVER_COLLECTION_DATE_SK)
        
        MAP_BUSINESS_REFERENCE(RENTAL_BOOKING_REFERENCE, BOOKING_REFERENCE)
        VALIDATE_BUSINESS_REFERENCE_INTEGRITY()
        
        APPLY_STRING_CLEANSING_RULES(CAPTURED_GARAGE_NAME, 255)
        APPLY_STRING_CLEANSING_RULES(CONTACT_DRIVER_NAME, 255)
        APPLY_STRING_CLEANSING_RULES(VOR_REGISTRATION_NUMBER, 10)
        APPLY_STRING_CLEANSING_RULES(VOR_INCIDENT_SOURCE, 20)
        APPLY_STRING_CLEANSING_RULES(VOR_WORK, 2000)
        APPLY_STRING_CLEANSING_RULES(CRS_LOG_ID, 20)
        
        VALIDATE_AND_PROCESS_NUMERIC(MILEAGE, DECIMAL, 38, 0)
        VALIDATE_AND_PROCESS_NUMERIC(NUMBER_OF_WORKING_DAYS_VOR, DECIMAL, 38, 0)
        VALIDATE_AND_PROCESS_NUMERIC(NUMBER_OF_DAYS_VOR, DECIMAL, 38, 0)
        VALIDATE_AND_PROCESS_NUMERIC(COMPLETION_TO_COLLECT_DAYS, DECIMAL, 38, 0)
        
        APPLY_BUSINESS_RULES_VALIDATION()
        CHECK_REFERENTIAL_INTEGRITY()
        
        APPLY_NULL_HANDLING_STRATEGY()
        ASSIGN_DEFAULT_VALUES_WHERE_APPLICABLE()
        
        APPLY_DATA_ENRICHMENT_RULES()
        CALCULATE_DERIVED_FIELDS()
        
        PERFORM_FINAL_RECORD_VALIDATION()
        
        IF validation_passed:
          OUTPUT_TO_LINK(transformed_data_link, processed_row)
        ELSE:
          OUTPUT_TO_LINK(reject_data_link, input_row)
        
        END_RECORD_PROCESSING()
      
      FINALIZE_TRANSFORMATION_CONTEXT()
      GENERATE_TRANSFORMATION_STATISTICS()
    
    OUTPUT_LINKS:
      transformed_data_link (LINK_TYPE: 1, TARGET: Target_Connector)
      reject_data_link (LINK_TYPE: 1, TARGET: Reject_Handler)
  
  STAGE_TRANSFORMER_V0A16:
    TYPE: CTransformerStage
    OPERATION: CLEANSE_MATCHED_VEHICLE_DATA
    INPUT_LINK: vehicle_matched_data (FROM LOOKUP_VEHICLE_DIMENSION)
    
    CLEANSING_OPERATIONS:
      FOR EACH record IN vehicle_matched_data:
        IF record.vehicle_sk IS NOT NULL THEN
          cleansed_record = APPLY_DATA_QUALITY_RULES(record)
          standardized_record = STANDARDIZE_VEHICLE_ATTRIBUTES(cleansed_record)
          validated_record = VALIDATE_REGISTRATION_NUMBER_FORMAT(standardized_record)
          OUTPUT validated_record TO vehicle_processed_data
        END IF
      END FOR
    
    OUTPUT_LINK: vehicle_processed_data (LINK_TYPE: 1, TARGET: SEQUENTIAL_FILE_TARGET)
  
  STAGE_TRANSFORMER_ERROR_HANDLER:
    TYPE: CTransformerStage
    OPERATION: HANDLE_UNMATCHED_RECORDS
    INPUT_LINK: vehicle_unmatched_data (FROM LOOKUP_VEHICLE_DIMENSION)
    
    ERROR_HANDLING_OPERATIONS:
      FOR EACH record IN vehicle_unmatched_data:
        error_record = LOG_UNMATCHED_REGISTRATION_NUMBER(record)
        timestamped_record = ADD_TIMESTAMP(error_record)
        coded_record = ADD_ERROR_CODES_AND_DESCRIPTIONS(timestamped_record)
        OUTPUT coded_record TO error_log_data
      END FOR
    
    OUTPUT_LINK: error_log_data (LINK_TYPE: 1, TARGET: ERROR_LOG_TARGET)
  
  STAGE_TRANSFORM_VOR_DATA:
    TYPE: CTransformerStage
    OPERATION: TRANSFORM_VOR_DATA_FOR_HASHED_FILE
    INPUT_LINK: lnk_source_to_transformer (FROM SOURCE_DATA)
    
    TRANSFORMATION_OPERATIONS:
      FOR EACH record IN lnk_source_to_transformer:
        transformed_vor_record = APPLY_VOR_TRANSFORMATIONS(record)
        validated_vor_record = VALIDATE_VOR_DATA(transformed_vor_record)
        OUTPUT validated_vor_record TO lnk_transformer_to_hashed_file
      END FOR
    
    OUTPUT_LINK: lnk_transformer_to_hashed_file
    LINK_TYPE: 1
    TARGET_STAGE: Load_HFVehicleoffRoad
  
  STAGE_DATA_INTEGRATION_TRANSFORM:
    TYPE: CTransformerStage
    OPERATION: INTEGRATE_MULTIPLE_SOURCE_DATA_STREAMS
    INPUT_LINKS: [
      VOR_VEHICLE_OFF_ROAD_Data (FROM VOR_VEHICLE_OFF_ROAD_SOURCE),
      VOR_PROGRESS_REPORTING_Data (FROM VOR_PROGRESS_REPORTING_SOURCE),
      D_VOR_NON_RETURN_REASON_Data (FROM D_VOR_NON_RETURN_REASON_SOURCE),
      VEHICLE_DIM_Data (FROM VEHICLE_DIM_SOURCE),
      SUPPLIER_DIM_Data (FROM SUPPLIER_DIM_SOURCE),
      CUSTOMER_DIM_Data (FROM CUSTOMER_DIM_SOURCE),
      DRIVER_ALLOC_VEH_DIM_Data (FROM DRIVER_ALLOC_VEH_DIM_SOURCE),
      D_VOR_NOTE_Data (FROM D_VOR_NOTE_SOURCE),
      VOR_I247_GARAGE_MAPPING_Data (FROM VOR_I247_GARAGE_MAPPING_SOURCE)
    ]
    PREVIOUS_LINKS: [
      VOR_VEHICLE_OFF_ROAD_SOURCE -> VOR_VEHICLE_OFF_ROAD_Data,
      VOR_PROGRESS_REPORTING_SOURCE -> VOR_PROGRESS_REPORTING_Data,
      D_VOR_NON_RETURN_REASON_SOURCE -> D_VOR_NON_RETURN_REASON_Data,
      VEHICLE_DIM_SOURCE -> VEHICLE_DIM_Data,
      SUPPLIER_DIM_SOURCE -> SUPPLIER_DIM_Data,
      CUSTOMER_DIM_SOURCE -> CUSTOMER_DIM_Data,
      DRIVER_ALLOC_VEH_DIM_SOURCE -> DRIVER_ALLOC_VEH_DIM_Data,
      D_VOR_NOTE_SOURCE -> D_VOR_NOTE_Data,
      VOR_I247_GARAGE_MAPPING_SOURCE -> VOR_I247_GARAGE_MAPPING_Data
    ]
    
    LOOKUP_OPERATIONS:
      SETUP_LOOKUP_VEHICLE_DIM:
        CACHE_LOOKUP_DATA(VEHICLE_DIM_Data)
        CREATE_LOOKUP_INDEX(VEHICLE_DIM_Data, "vehicle_id")
      
      SETUP_LOOKUP_SUPPLIER_DIM:
        CACHE_LOOKUP_DATA(SUPPLIER_DIM_Data)
        CREATE_LOOKUP_INDEX(SUPPLIER_DIM_Data, "supplier_id")
      
      SETUP_LOOKUP_CUSTOMER_DIM:
        CACHE_LOOKUP_DATA(CUSTOMER_DIM_Data)
        CREATE_LOOKUP_INDEX(CUSTOMER_DIM_Data, "customer_id")
      
      SETUP_LOOKUP_DRIVER_ALLOC_VEH_DIM:
        CACHE_LOOKUP_DATA(DRIVER_ALLOC_VEH_DIM_Data)
        CREATE_LOOKUP_INDEX(DRIVER_ALLOC_VEH_DIM_Data, "driver_id")
      
      SETUP_LOOKUP_D_VOR_NON_RETURN_REASON:
        CACHE_LOOKUP_DATA(D_VOR_NON_RETURN_REASON_Data)
        CREATE_LOOKUP_INDEX(D_VOR_NON_RETURN_REASON_Data, "reason_id")
      
      SETUP_LOOKUP_D_VOR_NOTE:
        CACHE_LOOKUP_DATA(D_VOR_NOTE_Data)
        CREATE_LOOKUP_INDEX(D_VOR_NOTE_Data, "note_id")
      
      SETUP_LOOKUP_VOR_I247_GARAGE_MAPPING:
        CACHE_LOOKUP_DATA(VOR_I247_GARAGE_MAPPING_Data)
        CREATE_LOOKUP_INDEX(VOR_I247_GARAGE_MAPPING_Data, "garage_id")
    
    TRANSFORMATION_LOGIC:
      FOR EACH vor_record IN VOR_VEHICLE_OFF_ROAD_Data:
        progress_record = LOOKUP(VOR_PROGRESS_REPORTING_Data, vor_record.worksheet_number)
        
        IF progress_record.FOUND THEN
          joined_record = JOIN_VOR_WITH_PROGRESS(vor_record, progress_record)
        ELSE
          joined_record = vor_record
        END IF
        
        vehicle_lookup = LOOKUP(VEHICLE_DIM_Data, joined_record.vehicle_id)
        IF vehicle_lookup.FOUND THEN
          joined_record = ENRICH_WITH_VEHICLE_DIM(joined_record, vehicle_lookup)
        END IF
        
        supplier_lookup = LOOKUP(SUPPLIER_DIM_Data, joined_record.supplier_id)
        IF supplier_lookup.FOUND THEN
          joined_record = ENRICH_WITH_SUPPLIER_DIM(joined_record, supplier_lookup)
        END IF
        
        customer_lookup = LOOKUP(CUSTOMER_DIM_Data, joined_record.customer_id)
        IF customer_lookup.FOUND THEN
          joined_record = ENRICH_WITH_CUSTOMER_DIM(joined_record, customer_lookup)
        END IF
        
        driver_lookup = LOOKUP(DRIVER_ALLOC_VEH_DIM_Data, joined_record.driver_id)
        IF driver_lookup.FOUND THEN
          joined_record = ENRICH_WITH_DRIVER_ALLOC_VEH_DIM(joined_record, driver_lookup)
        END IF
        
        reason_lookup = LOOKUP(D_VOR_NON_RETURN_REASON_Data, joined_record.reason_id)
        IF reason_lookup.FOUND THEN
          joined_record = ENRICH_WITH_VOR_NON_RETURN_REASON(joined_record, reason_lookup)
        END IF
        
        note_lookup = LOOKUP(D_VOR_NOTE_Data, joined_record.note_id)
        IF note_lookup.FOUND THEN
          joined_record = ENRICH_WITH_VOR_NOTE(joined_record, note_lookup)
        END IF
        
        garage_lookup = LOOKUP(VOR_I247_GARAGE_MAPPING_Data, joined_record.garage_id)
        IF garage_lookup.FOUND THEN
          joined_record = ENRICH_WITH_GARAGE_MAPPING(joined_record, garage_lookup)
        END IF
        
        PERFORM_DATA_VALIDATION_AND_CLEANSING(joined_record)
        HANDLE_NULL_VALUES(joined_record)
        APPLY_DATA_QUALITY_CHECKS(joined_record)
        APPLY_BUSINESS_RULES_AND_CALCULATIONS(joined_record)
        
        transformed_record = FINALIZE_TRANSFORMATION(joined_record)
        OUTPUT transformed_record TO Transformed_VOR_Data
      END FOR
    
    OUTPUT_LINK: Transformed_VOR_Data
    LINK_TYPE: 1
    TARGET_STAGE: Target_Load
    NEXT_LINK: Transformed_VOR_Data -> Target_Load
  
  STAGE_EXCEPTION_DATA_MERGER:
    TYPE: CTransformerStage
    OPERATION: MERGE_EXCEPTION_DATA_WITH_MAIN_FLOW
    INPUT_LINK: Processed_Exception_Data (FROM NEXT_PROCESSING_STAGE)
    PREVIOUS_LINK: Next_Processing_Stage -> Processed_Exception_Data
    
    EXCEPTION_MERGER_OPERATIONS:
      FOR EACH processed_exception IN Processed_Exception_Data:
        VALIDATE_EXCEPTION_COMPLETENESS(processed_exception)
        APPLY_EXCEPTION_BUSINESS_RULES(processed_exception)
        STANDARDIZE_EXCEPTION_FORMAT(processed_exception)
        
        merged_exception_record = CREATE_MERGED_EXCEPTION_RECORD(processed_exception)
        OUTPUT merged_exception_record TO Exception_Output_Stream
      END FOR
    
    OUTPUT_LINK: Exception_Output_Stream
    LINK_TYPE: 1
    TARGET_STAGE: Exception_File_Writer
    NEXT_LINK: Exception_Output_Stream -> Exception_File_Writer
  
  GOTO LINK_7_LOOKUP_PROCESSING

LINK_7_LOOKUP_PROCESSING:
  STAGE_LOOKUP_lkVehicleDim_REg:
    TYPE: CLookupStage
    OPERATION: LOOKUP_VEHICLE_DIMENSION_DATA
    INPUT_LINK: DSLink4 (FROM Transformer_1)
    LOOKUP_PARTNER: V116S0|V116S0P2
    LINK_TYPE: 2
    MULTI_ROW: 0
    LINK_MINIMISED: 0
    
    LOOKUP_OPERATIONS:
      FOR EACH record IN DSLink4:
        lookup_key = EXTRACT_LOOKUP_KEY(record)
        lookup_result = LOOKUP_REFERENCE_DATA(lookup_key, V116S0|V116S0P2)
        enriched_record = MERGE(record, lookup_result)
        OUTPUT enriched_record TO lkVehicleDim_REg
      END FOR
    
    OUTPUT_LINK: lkVehicleDim_REg
    LINK_TYPE: 2
    TARGET_STAGE: Sequential_File_2
  
  STAGE_LOOKUP_VEHICLE_DIMENSION:
    TYPE: CLookupStage
    OPERATION: RESOLVE_VEHICLE_SK_BY_REGISTRATION
    INPUT_LINK: Lnk_Transformed_Vehicle_Data (FROM TRANSFORMER_DATA_PROCESSING)
    LOOKUP_TABLE: HF_SMR_VEHICLE_DIM_REG
    LOOKUP_KEY: STANDARDIZED_REG_NO = REGISTRATION_NO
    PREVIOUS_LINK: Transformer_Data_Processing -> Lnk_Transformed_Vehicle_Data
    STAGE_NAME: lkVehicleDim_REg
    PARTNER: V0S2|V0S2P7
    
    LOOKUP_PROPERTIES:
      IN_MEMORY: 0
      NORMALIZE: Un-Normalized
      RECORD_LEVEL_READ: 0
    
    LOOKUP_COLUMNS:
      VEHICLE_SK: BIGINT, PRECISION=19, NULLABLE=TRUE
      OBJECT_NO: VARCHAR, PRECISION=15, NULLABLE=TRUE
      REGISTRATION_NO: VARCHAR, PRECISION=18, NULLABLE=FALSE, KEY_POSITION=1
      CUST_ID: BIGINT, PRECISION=19, NULLABLE=TRUE
      VARIANT_SK: BIGINT, PRECISION=19, NULLABLE=TRUE
    
    LOOKUP_CONDITION:
      KEY_EXPRESSION: Lnk_Transformed_Vehicle_Data.STANDARDIZED_REG_NO
      PARSED_DERIVATION: Lnk_Transformed_Vehicle_Data.STANDARDIZED_REG_NO
      SOURCE_COLUMN: Lnk_Transformed_Vehicle_Data.STANDARDIZED_REG_NO
    
    LOOKUP_OPERATIONS:
      FOR EACH record IN Lnk_Transformed_Vehicle_Data:
        lookup_result = LOOKUP(HF_SMR_VEHICLE_DIM_REG, record.STANDARDIZED_REG_NO)
        
        IF lookup_result.FOUND THEN
          matched_record = MERGE_RECORD(record, lookup_result.VEHICLE_SK, lookup_result.OBJECT_NO, lookup_result.CUST_ID, lookup_result.VARIANT_SK)
          OUTPUT matched_record TO Lnk_Enriched_Vehicle_Data
        ELSE
          unmatched_record = MARK_AS_UNMATCHED(record)
          OUTPUT unmatched_record TO Lnk_Enriched_Vehicle_Data
        END IF
      END FOR
    
    LOOKUP_FAILURE: REJECT
    OUTPUT_LINK: Lnk_Enriched_Vehicle_Data
    LINK_TYPE: 2
    TARGET_STAGE: Transformer_Quality_Validation
    NEXT_LINK: Lnk_Enriched_Vehicle_Data -> Transformer_Quality_Validation
  
  STAGE_LOOKUP_VEHICLE_DIMENSION_ORIGINAL:
    TYPE: CLookupStage
    OPERATION: RESOLVE_VEHICLE_SK
    INPUT_LINK: vehicle_raw_data (FROM SEQUENTIAL_FILE_SOURCE)
    REFERENCE_LINK: Vehicle_Dimension_Table
    LOOKUP_KEY: Registration_Number
    
    LOOKUP_OPERATIONS:
      FOR EACH record IN vehicle_raw_data:
        lookup_result = LOOKUP(Vehicle_Dimension_Table, record.Registration_Number)
        
        IF lookup_result.FOUND THEN
          matched_record = MERGE_RECORD(record, lookup_result.vehicle_sk)
          OUTPUT matched_record TO vehicle_matched_data
        ELSE
          unmatched_record = MARK_AS_UNMATCHED(record)
          OUTPUT unmatched_record TO vehicle_unmatched_data
        END IF
      END FOR
    
    OUTPUT_LINKS:
      vehicle_matched_data (LINK_TYPE: 1, TARGET: TRANSFORMER_V0A16)
      vehicle_unmatched_data (LINK_TYPE: 1, TARGET: TRANSFORMER_ERROR_HANDLER)
  
  GOTO LINK_8_VALIDATION_PROCESSING

LINK_8_VALIDATION_PROCESSING:
  STAGE_TRANSFORMER_QUALITY_VALIDATION:
    TYPE: CTransformerStage
    OPERATION: VALIDATE_DATA_QUALITY_AND_BUSINESS_RULES
    INPUT_LINK: Lnk_Enriched_Vehicle_Data (FROM LOOKUP_VEHICLE_DIMENSION)
    PREVIOUS_LINK: Lookup_Vehicle_Dimension -> Lnk_Enriched_Vehicle_Data
    
    VALIDATION_RULES:
      FOR EACH record IN Lnk_Enriched_Vehicle_Data:
        VEHICLE_VALID = CHECK_VEHICLE_SK_EXISTS(record.VEHICLE_SK)
        REG_FORMAT_VALID = VALIDATE_REGISTRATION_FORMAT(record.REGISTRATION_NO)
        CUST_RANGE_VALID = CHECK_CUSTOMER_ID_RANGE(record.CUST_ID)
        VARIANT_VALID = VALIDATE_VARIANT_SK(record.VARIANT_SK)
        
        CONSTRAINT_LOGIC:
          IF VEHICLE_VALID = FALSE OR REG_FORMAT_VALID = FALSE THEN
            rejected_record = CREATE_REJECT_RECORD(record, "Vehicle validation failed or invalid registration format")
            OUTPUT rejected_record TO Lnk_Rejected_Records
          ELSE
            validated_record = CREATE_VALIDATED_RECORD(record)
            OUTPUT validated_record TO Lnk_Validated_Data
          END IF
      END FOR
    
    OUTPUT_LINKS:
      Lnk_Validated_Data (LINK_TYPE: 1, TARGET: Sequential_File_Target_Vehicle_Processed)
      Lnk_Rejected_Records (LINK_TYPE: 1, TARGET: Sequential_File_Reject_Handler)
    NEXT_LINK: Lnk_Validated_Data -> Sequential_File_Target_Vehicle_Processed
    REJECT_NEXT_LINK: Lnk_Rejected_Records -> Sequential_File_Reject_Handler
  
  GOTO LINK_9_COPY_PROCESSING

LINK_9_COPY_PROCESSING:
  STAGE_COPY_1:
    TYPE: CCopyStage
    OPERATION: COPY_DATA_TO_MULTIPLE_OUTPUTS
    INPUT_LINK: V0S1P1 (FROM TRANSFORMER_1)
    
    COPY_OPERATIONS:
      FOR EACH record IN V0S1P1:
        OUTPUT record TO V0S2P1
        OUTPUT record TO V0S2P2
      END FOR
    
    OUTPUT_LINKS:
      V0S2P1 (LINK_TYPE: 1, TARGET: JOIN_1)
      V0S2P2 (LINK_TYPE: 1, TARGET: JOIN_1)
  
  GOTO LINK_10_JOIN_PROCESSING

LINK_10_JOIN_PROCESSING:
  STAGE_JOIN_1:
    TYPE: CJoinStage
    OPERATION: JOIN_DATA_STREAMS
    INPUT_LINKS: V0S2P1, V0S2P2 (FROM COPY_1)
    
    JOIN_OPERATIONS:
      left_data = INPUT FROM V0S2P1
      right_data = INPUT FROM V0S2P2
      joined_data = PERFORM_JOIN_OPERATION(left_data, right_data)
      OUTPUT joined_data TO V0S3P1
    
    OUTPUT_LINK: V0S3P1
    LINK_TYPE: 1
    TARGET_STAGE: AGGREGATOR_1
  
  GOTO LINK_11_AGGREGATION_PROCESSING

LINK_11_AGGREGATION_PROCESSING:
  STAGE_AGGREGATOR_1:
    TYPE: CAggregatorStage
    OPERATION: AGGREGATE_DATA
    INPUT_LINK: V0S3P1 (FROM JOIN_1)
    
    AGGREGATION_OPERATIONS:
      aggregated_data = PERFORM_AGGREGATION_OPERATIONS(V0S3P1)
      OUTPUT aggregated_data TO V0S4P1
    
    OUTPUT_LINK: V0S4P1
    LINK_TYPE: 1
    TARGET_STAGE: SORT_1
  
  GOTO LINK_12_SORT_PROCESSING

LINK_12_SORT_PROCESSING:
  STAGE_SORT_1:
    TYPE: CSortStage
    OPERATION: SORT_DATA
    INPUT_LINK: V0S4P1 (FROM AGGREGATOR_1)
    
    SORT_OPERATIONS:
      sorted_data = SORT_DATA_BY_SPECIFIED_COLUMNS(V0S4P1)
      OUTPUT sorted_data TO V0S5P1
    
    OUTPUT_LINK: V0S5P1
    LINK_TYPE: 1
    TARGET_STAGE: REMOVE_DUPLICATES_1
  
  GOTO LINK_13_DEDUPLICATION_PROCESSING

LINK_13_DEDUPLICATION_PROCESSING:
  STAGE_REMOVE_DUPLICATES_1:
    TYPE: CRemDupStage
    OPERATION: REMOVE_DUPLICATE_RECORDS
    INPUT_LINK: V0S5P1 (FROM SORT_1)
    
    DEDUPLICATION_OPERATIONS:
      deduplicated_data = REMOVE_DUPLICATE_RECORDS(V0S5P1)
      OUTPUT deduplicated_data TO V0S6P1
    
    OUTPUT_LINK: V0S6P1
    LINK_TYPE: 1
    TARGET_STAGE: FUNNEL_1
  
  STAGE_REMOVE_DUPLICATES_V0A17:
    TYPE: CRemDupStage
    OPERATION: REMOVE_DUPLICATES_VEHICLE_DRIVER_ALLOCATION
    INPUT_LINK: source_data (FROM SEQUENTIAL_FILE_SOURCE_V0A17)
    
    DEDUPLICATION_LOGIC:
      PARTITION_BY: vehicle_id, driver_id, allocation_date
      SORT_BY: vehicle_id ASC, driver_id ASC, allocation_date ASC, record_timestamp DESC
      RETAIN: FIRST record per partition group
      DROP: subsequent duplicate records
    
    OUTPUT_LINK: deduplicated_data
    LINK_TYPE: 1
    TARGET_STAGE: DATA_QUALITY_CHECK
  
  STAGE_DATA_QUALITY_CHECK:
    TYPE: CTransformerStage
    OPERATION: VALIDATE_DATA_QUALITY
    INPUT_LINK: deduplicated_data (FROM REMOVE_DUPLICATES_V0A17)
    
    VALIDATION_LOGIC:
      FOR EACH record IN deduplicated_data:
        IF record.vehicle_id IS NOT NULL AND record.driver_id IS NOT NULL AND record.allocation_date IS NOT NULL THEN
          validated_record = APPLY_QUALITY_CHECKS(record)
          OUTPUT validated_record TO validated_data
        ELSE
          reject_record = CREATE_QUALITY_REJECT_RECORD(record, "Missing required fields")
          OUTPUT reject_record TO quality_rejects
        END IF
      END FOR
    
