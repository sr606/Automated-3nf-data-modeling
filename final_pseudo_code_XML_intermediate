          DRIVER_COLLECTION_DATE_SK -> DRIVER_COLLECTION_DATE_SK
          VOR_REGISTRATION_NUMBER -> VOR_REGISTRATION_NUMBER
          CAPTURED_GARAGE_NAME -> CAPTURED_GARAGE_NAME
          CONTACT_DRIVER_NAME -> CONTACT_DRIVER_NAME
          MILEAGE -> MILEAGE
          VOR_INCIDENT_SOURCE -> VOR_INCIDENT_SOURCE
          VOR_WORK -> VOR_WORK
          CRS_LOG_ID -> CRS_LOG_ID
          NUMBER_OF_WORKING_DAYS_VOR -> NUMBER_OF_WORKING_DAYS_VOR
          NUMBER_OF_DAYS_VOR -> NUMBER_OF_DAYS_VOR
          COMPLETION_TO_COLLECT_DAYS -> COMPLETION_TO_COLLECT_DAYS
        
        EXECUTE_INSERT_STATEMENT(mapped_row)
        
        IF batch_size_reached(TRANSACTION_SIZE):
          COMMIT_TRANSACTION_BATCH()
          BEGIN_NEW_TRANSACTION_BATCH()
    
    POST_LOAD_PROCESSING:
      COMMIT_FINAL_TRANSACTION_BATCH()
      GENERATE_LOAD_STATISTICS()
      UPDATE_DATA_LINEAGE_METADATA()
      CLOSE_TARGET_CONNECTION()
  
  STAGE_TARGET_OUTPUT:
    TYPE: CSeqFileStage
    OPERATION: WRITE_NORMAL_DATA_FROM_OUTPUT_TRANSFORMER
    INPUT_LINK: Transformed_Data (FROM OUTPUT_TRANSFORMER)
    
    TARGET_OUTPUT_OPERATIONS:
