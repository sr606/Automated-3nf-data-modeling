    INPUT_LINK_1: DSLink4 (FROM TRANSFORMER_2)
    INPUT_LINK_2: V116S0P2 (FROM HF_SMR_VEHICLE_DIM)
    
    JOIN_OPERATIONS:
      RECEIVE main_data FROM DSLink4
      RECEIVE lookup_data FROM V116S0P2
      
      FOR EACH main_record IN main_data:
        FOR EACH lookup_record IN lookup_data:
          IF MATCH_RECORDS_ON_KEY_FIELDS(main_record, lookup_record) THEN
            merged_record = MERGE_DATA_ATTRIBUTES(main_record, lookup_record)
            APPLY_FINAL_TRANSFORMATIONS(merged_record)
            OUTPUT merged_record TO DSLink5
          ELSE
            unmatched_record = HANDLE_UNMATCHED_RECORDS(main_record)
            OUTPUT unmatched_record TO DSLink5
          END IF
        END FOR
      END FOR
    
