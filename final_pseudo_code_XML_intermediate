        WRITE_RECORD(formatted_record, target_file_path)
        UPDATE_LOAD_STATISTICS()
      END FOR
      
      CLOSE_SEQUENTIAL_FILE(target_file_path)
      VALIDATE_TARGET_FILE_CREATION(target_file_path)
  
  STAGE_ERROR_LOG_TARGET:
    TYPE: CSeqFileStage
    OPERATION: WRITE_ERROR_LOG_RECORDS
    INPUT_LINK: error_log_data (FROM TRANSFORMER_ERROR_HANDLER)
    
    ERROR_LOG_OPERATIONS:
      error_log_path = pSMROutputPath + "/vehicle_error_log_" + pFiledate + ".txt"
      OPEN_SEQUENTIAL_FILE(error_log_path, "WRITE_MODE")
      
      FOR EACH error_record IN error_log_data:
